# Opcional: key inicial; luego se puede rotar desde el panel admin sin redeploy.
RIOT_API_KEY=
ADMIN_TOKEN=

# Docker Compose defaults
APP_DIR=/app
DATA_DIR=/data
DATABASE_PATH=/data/hardstuck.sqlite
APP_UID=1000
APP_GID=1000
HOST_PORT=3000
CONTAINER_PORT=3000
DATA_SOURCE=hardstuck-data
DATA_VOLUME_NAME=hardstuck-data
